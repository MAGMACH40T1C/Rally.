{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/match.js": {
      "includeFiles": "{BRIEF.md,NOTES.md,src/data/places.json,ai/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
